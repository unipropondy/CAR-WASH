{
  "expo": {
    "name": "RED BAY CAR WASH POS",
    "slug": "red-bay-carwash",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/red_bay_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/red_bay_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "web": {
      "favicon": "./assets/images/red_bay_logo.png",
      "bundler": "metro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/red_bay_logo.png",
        "backgroundColor": "#080808"
      },
      "package": "com.redbay.carwash.pos",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "apiUrl": "https://car-wash.up.railway.app",
      "eas": {
        "projectId": "8794d2c8-89f4-41c6-a6fc-fdfcae04b407"
      }
    }
  }
}
